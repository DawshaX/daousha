# ==================================================================
# XDAW NOVA — النسخة النهائية | دليل متغيرات البيئة
# انسخ هذا الملف إلى secrets.txt (للتشغيل المحلي) أو أضف القيم
# في GitHub Secrets (للتشغيل التلقائي). كل شيء اختياري عدا ما ذُكر.
# ==================================================================

# ---------- YouTube (اختياري — بدونه يُتخطى النشر على YT) ----------
# من Google Cloud Console → OAuth client (Desktop app) + فعّل YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------- Facebook Reels (اختياري) ----------
# صفحة + token دائم (Long-lived page access token)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------- Instagram Reels (اختياري) ----------
# حساب IG تجاري مرتبط بصفحة فيسبوك + token طويل الأمد بصلاحية instagram_content_publish
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ---------- Telegram (اختياري — إشعارات) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- مشاهد Stock حقيقية من Pexels (اختياري — مجاني 200 طلب/ساعة) ----------
# بدونه: المشاهد تُولَّد برمجيًا بهوية العلامة (كحلي داكن + وهج كهرماني) — يعمل دائمًا
PEXELS_API_KEY=

# ---------- توليد سيناريوهات لا نهائية عبر LLM (اختياري) ----------
# أي endpoint متوافق مع OpenAI (مثل Groq المجاني: https://api.groq.com/openai/v1)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---------- ضبط النشر ----------
# صوت دوشة: ar-EG-SalmaNeural (أنثوي مصري لطيف) — بدائل: ar-SA-ZariyahNeural
NOVA_VOICE_AR=ar-EG-SalmaNeural
NOVA_VOICE_EN=en-US-JennyNeural
# سقف الحلقات اليومي (السلم الآمن يبدأ 4 ويرتفع تلقائيًا مع streak حتى 16+)
NOVA_DAILY_CAP=4
# أقل فارق زمني بين حلقتين على نفس المنصة (ساعات)
NOVA_PLATFORM_GAP_H=4
# اللغات المنشورة (ar أو ar,en)
NOVA_LANGS=ar
# موسيقى خلفية مولدة مجانًا (0 لإيقافها)
NOVA_MUSIC_VOLUME=0.10
# تفعيل TikTok (لا تفعّله إلا بعد قبول تطبيقك رسميًا)
NOVA_TIKTOK_ENABLED=0
